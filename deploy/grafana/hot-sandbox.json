    {
      "id": 15,
      "type": "stat",
      "title": "Mean claim latency (ms)",
      "datasource": {
        "type": "prometheus",
        "uid": "volc-vmp"
      },
      "description": "sandboxd_claim_seconds_total / sandboxd_claims_total over 5m — mean warm-checkout latency. sandboxd exports totals (not a histogram), so this is the mean, not a quantile.",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 38
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "volc-vmp"
          },
          "expr": "(sum(rate(sandboxd_claim_seconds_total[5m])) / sum(rate(sandboxd_claims_total[5m])) * 1000) or vector(0)",
          "legendFormat": "",
          "refId": "A",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 200
              },
              {
                "color": "red",
                "value": 1000
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
