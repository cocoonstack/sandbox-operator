{
  "uid": "hot-sandbox",
  "title": "Hot Sandbox — warm pools",
  "tags": [
    "cocoon",
    "sandbox",
    "warmpool"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 12,
  "refresh": "5s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "editable": true,
  "panels": [
    {
      "id": 900,
      "type": "row",
      "title": "⓪ Fill matrix — per-node warm, live (5s samples)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 901,
      "type": "status-history",
      "title": "Per-node warm matrix (a cell is the node's warm count at that instant; greener is fuller)",
      "datasource": {
        "type": "prometheus",
        "uid": "volc-vmp"
      },
      "interval": "5s",
      "description": "sum by(host)(sandboxd_pool_warm). One row per node, time on the X axis, one cell per 5s. How fast a column turns from red to green after a pool opens is the fill speed.",
      "gridPos": {
        "h": 10,
        "w": 18,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "volc-vmp"
          },
          "expr": "sum by (host) (sandboxd_pool_warm)",
          "legendFormat": "{{host}}",
          "refId": "A",
          "interval": "5s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "dark-red",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              },
              {
                "color": "orange",
                "value": 10
              },
              {
                "color": "yellow",
                "value": 25
              },
              {
                "color": "green",
                "value": 37
              }
            ]
          },
          "custom": {
            "fillOpacity": 90,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "colWidth": 0.95,
        "rowHeight": 0.9,
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 902,
      "type": "timeseries",
      "title": "Total warm (5s)",
      "datasource": {
        "type": "prometheus",
        "uid": "volc-vmp"
      },
      "interval": "5s",
      "description": "sum(sandboxd_pool_warm), 5s samples. A pool opening shows as a near-vertical step: the fill takes seconds.",
      "gridPos": {
        "h": 10,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "volc-vmp"
          },
          "expr": "sum(sandboxd_pool_warm) or vector(0)",
          "legendFormat": "warm",
          "refId": "A",
          "interval": "5s"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "volc-vmp"
          },
          "expr": "sum(sandboxd_pool_target) or vector(0)",
          "legendFormat": "target",
          "refId": "B",
          "interval": "5s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15,
            "showPoints": "always",
            "pointSize": 4,
            "gradientMode": "opacity",
            "stepInterval": null
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "target"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    6,
                    6
                  ]
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "text"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
