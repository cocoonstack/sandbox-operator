    {
      "id": 16,
      "type": "timeseries",
      "title": "Mean claim latency over time (ms)",
      "datasource": {
        "type": "prometheus",
        "uid": "volc-vmp"
      },
      "description": "Mean warm-checkout latency over time. Warm hits are sub-ms; a rising line means the pool is draining faster than it refills (cold/clone fallback).",
      "gridPos": {
        "h": 8,
        "w": 18,
        "x": 6,
        "y": 38
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "volc-vmp"
          },
          "expr": "(sum(rate(sandboxd_claim_seconds_total[5m])) / sum(rate(sandboxd_claims_total[5m])) * 1000) or vector(0)",
          "legendFormat": "mean (fleet)",
          "refId": "A",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "volc-vmp"
          },
